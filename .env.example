# Copy this file to .env (gitignored) and fill in the keys.
# The example runner loads .env so keyed examples can run locally.
# Examples that reference a missing required key (ENV.fetch("X") without a
# default) are skipped by the runner, so CI passes without keys.

# OpenCode Go — https://opencode.ai/zen
OPENCODE_GO_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Mistral — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
